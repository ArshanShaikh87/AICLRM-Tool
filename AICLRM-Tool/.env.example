# Copy this file to .env.local and fill in your values

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# Rate limiting (Upstash Redis) — https://console.upstash.com
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN


# CORS — comma-separated list, production + preview domains, no trailing slash
# e.g. https://aiclrm.vercel.app,https://aiclrm-tool-git-main-yourname.vercel.app
ALLOWED_ORIGIN=https://your-production-domain.vercel.app

# Sentry (frontend)   Vite only exposes VITE_ prefixed vars to browser code
VITE_SENTRY_DSN=YOUR_FRONTEND_SENTRY_DSN

# Sentry (backend)
SENTRY_DSN=YOUR_BACKEND_SENTRY_DSN